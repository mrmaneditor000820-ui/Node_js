<!DOCTYPE html>
<html>
<head>
    <title>Todo</title>
</head>
<body>

<ul>

<% for(let i = 0; i < todos.length; i++) { %>

<li>

<b><%= todos[i].name %></b>

<br>

Status :

<%= todos[i].completed ? "True" : "False" %>

<form action="/todo/toggle/<%= todos[i].id %>" method="POST">

<button>

<%= todos[i].completed ? "Mark False" : "Mark True" %>

</button>

</form>

</li>

<hr>

<% } %>

</ul>

</body>
</html>